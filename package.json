{
  "name": "@alphapay/react-native",
  "version": "0.1.0",
  "description": "Official React Native / TypeScript SDK for AlphaPay hosted checkout sessions — client-side only, no secret key.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react-native": ">=0.70.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist-test/**/*.test.js",
    "pretest": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
